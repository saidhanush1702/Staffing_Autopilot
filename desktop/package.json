{
  "name": "smartapply-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "SmartApply consultant desktop app \u2014 fills job applications and stops for the consultant to submit.",
  "main": "src/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on tcp:5273 && electron .",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "test": "node tests/run.mjs && node tests/dom.mjs",
    "test:dom": "node tests/dom.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "verify:board": "node tools/verify-board.mjs",
    "try:linkedin": "node tools/try-linkedin.mjs",
    "probe:selectors": "node tools/probe-selectors.mjs",
    "dist": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.49.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.molinatek.smartapply",
    "productName": "SmartApply",
    "files": [
      "src/main/**",
      "src/preload/**",
      "dist-renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
