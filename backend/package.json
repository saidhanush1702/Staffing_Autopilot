{
  "name": "smartapply-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrate.js",
    "test": "node --test tests/",
    "test:answers": "node tests/answers.test.mjs",
    "test:discovery": "node tests/discovery.test.mjs",
    "discover": "node -e \"import('./jobs/discoveryScheduler.js').then(m=>m.runCycle().then(()=>process.exit(0)))\"",
    "test:llm": "node tests/llm.test.mjs",
    "test:worker": "node tests/worker.test.mjs",
    "test:tailoring": "node tests/tailoring.test.mjs",
    "test:contacts": "node tests/contacts.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "test:phase7": "node tests/llm.test.mjs && node tests/worker.test.mjs && node tests/tailoring.test.mjs && node tests/contacts.test.mjs && node tests/e2e.test.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.2",
    "multer": "^2.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
