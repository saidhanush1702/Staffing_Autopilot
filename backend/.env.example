# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# ── Database (PostgreSQL) ─────────────────────────────────
# app_role: runtime connection. CRUD only, no DDL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=staffing_autopilot
DB_USER=app_role
DB_PASS=app_dev_pw

# migrator_role: used by migrate.js only. Owns the schema.
DB_MIGRATION_USER=migrator_role
DB_MIGRATION_PASS=migrator_dev_pw

# ── Database: managed provider (Neon / Supabase / Render) ──
# Set DATABASE_URL and every DB_* var above is ignored — managed providers
# issue one connection string and usually one role, so there is no
# migrator/app split to make. Migration 005 already guards its GRANT behind a
# pg_roles check, so it skips cleanly when app_role does not exist.
# DATABASE_URL=postgresql://user:password@host/dbname
#
# Only if your provider lets you create a second, more privileged role:
# MIGRATION_DATABASE_URL=

# Managed Postgres requires TLS; a local install does not. Must be "true" for
# Neon, Supabase and Render, or the connection is refused outright.
DB_SSL=false

# ── Auth ──────────────────────────────────────────────────
# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# AES-256-GCM key for reversible password storage.
# MUST be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: passwords are recoverable with this key. Anyone holding both a
# database dump and this value can read every user's plaintext password.
# Keep it out of version control and off the database host in production.
PASSWORD_ENC_KEY=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowlist. Credentials are sent, so '*' is not permitted.
#
# Still required when the frontend host proxies /api to this server. A browser
# attaches Origin to every non-GET/HEAD request — including a SAME-ORIGIN POST
# — and the proxy forwards it. Omitting the deployed origin therefore lets
# GET /api/health pass while every login POST is rejected, which reads like a
# broken login rather than a CORS allowlist miss.
CLIENT_ORIGIN=http://localhost:5173

# ── Split-domain hosting ──────────────────────────────────
# Only when the SPA is served from a DIFFERENT domain than this API and no
# proxy sits in front. A SameSite=Lax cookie is not attached to a cross-site
# request, so login appears to succeed and every call after it returns 401.
# Setting this to "true" switches the cookie to SameSite=None + Secure.
#
# Requires HTTPS (Secure cookies are dropped on plain HTTP), and the cookie
# becomes third-party — Safari blocks those by default, which also breaks the
# in-app PDF preview. Prefer the proxy.
CROSS_SITE_COOKIE=false

# ── SMTP (unused in Phase 1, reserved) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# ── Seed defaults (Phase 1 bootstrap) ─────────────────────
SEED_SUPER_ADMIN_EMAIL=superadmin@staffing.local
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_SUPER_ADMIN_NAME=Platform Owner

# ── Job discovery (Phase 5) ───────────────────────────────
# The automatic cycle is OFF unless this is exactly "true", so a fresh checkout
# never starts reaching out on its own.
DISCOVERY_ENABLED=false

# The cycle interval, the monthly search budget and the recency window are NOT
# set here. They are per-organisation settings an ORG_ADMIN owns from the Job
# Discovery screen, because two agencies on different provider plans cannot
# share one interval or one budget.
#
# DISCOVERY_ENABLED above stays here on purpose: it answers a different
# question — whether THIS PROCESS runs the cycle at all — so a developer's
# laptop never starts spending an agency's credits. Both must be true.

# ── Search provider — Google Jobs via SerpApi ─────────────
# Postings come from Google's index of the job boards, not from crawling them.
# Leave SERPAPI_KEY empty and discovery still runs: it fetches nothing, says so
# in the run notes, and matches whatever is already in the posting pool.
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_TIMEOUT_MS=20000

# Country and language for the search.
DISCOVERY_GL=us
DISCOVERY_HL=en

# Recency is chosen per organisation in the UI, not here. Google's narrowest
# window is a DAY — there is no "last 4 hours" filter at any price. Restricting
# a run to only what arrived since the last cycle is done by de-duplication
# downstream, not by the request.

# ── Cost control. EVERY RESULT PAGE IS ONE API CREDIT. ────
#   credits per run = DISCOVERY_MAX_QUERIES x DISCOVERY_MAX_PAGES
# At the defaults below that is 12 per run; on the 4-hour cycle, ~72/day.
# Check these against your plan's monthly quota before switching the cycle on.
DISCOVERY_MAX_QUERIES=6
DISCOVERY_MAX_PAGES=2

# A hard ceiling for one run, whatever the two settings above work out to.
# Stops a misconfiguration from spending a month's quota in a single cycle.
DISCOVERY_MAX_CALLS_PER_RUN=20


# ── Background worker (Phase 7) ───────────────────────────
# Runs resume tailoring and contact discovery. OFF unless this is exactly
# "true", so a fresh checkout never spends money on its own — the same rule
# DISCOVERY_ENABLED follows, and for the same reason.
WORKER_ENABLED=false
WORKER_INTERVAL_MS=15000
WORKER_BATCH_SIZE=5
WORKER_LEASE_MINUTES=10

# ── The model provider — NOT YET DECIDED ──────────────────
#
# Nothing in this codebase assumes a vendor. Pick one here and the whole
# pipeline uses it; pick a different one tomorrow and nothing else changes.
#
#   anthropic | claude          Claude, via the Messages API
#   openai                      OpenAI
#   gemini | google             Google Gemini
#   deepseek | qwen | groq |    anything speaking the OpenAI chat-completions
#   together | openrouter |     dialect — set LLM_OPENAI_BASE_URL to point at it
#   ollama | compatible
#   mock                        the built-in test provider. Free, deterministic,
#                               used by tests/tailoring.test.mjs
#
# Leave LLM_PROVIDER empty and the feature is simply off: jobs still reach
# READY carrying the consultant's base resume, marked NOT_TAILORED with the
# reason LLM_NOT_CONFIGURED. Nothing breaks and no application is held up.
LLM_PROVIDER=
LLM_MODEL=
LLM_TIMEOUT_MS=120000

# Per-stage overrides. Each falls back to LLM_PROVIDER / LLM_MODEL above, so
# the expensive stage can run on one vendor and the cheap ones on another.
#   parse   base resume -> structure. Once per resume, not per job.
#   tailor  the quality-critical rewrite.
#   check   the independent no-fabrication check.
# LLM_PARSE_PROVIDER=
# LLM_PARSE_MODEL=
# LLM_TAILOR_PROVIDER=
# LLM_TAILOR_MODEL=
# LLM_CHECK_PROVIDER=
# LLM_CHECK_MODEL=

# Credentials. Only the one matching your chosen provider is needed; none of
# them ever enters the database.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Used by every OpenAI-dialect provider. Point the base URL at the vendor:
#   OpenAI    https://api.openai.com
#   DeepSeek  https://api.deepseek.com
#   Groq      https://api.groq.com/openai
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=https://api.openai.com

GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# The monthly spend ceiling is PER ORGANISATION and set in the UI, not here —
# two agencies sharing an installation do not share a budget. Reaching it never
# holds an application back: the job goes out with the base resume, marked
# NOT_TAILORED / BUDGET_EXHAUSTED.

# ── Contact discovery — Apollo (Phase 7) ──────────────────
# Named by organization_providers.credential_env. The key stays in the
# environment and never enters the database, exactly like SERPAPI_KEY.
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io
APOLLO_TIMEOUT_MS=20000

# How long a stored contact may be reused before a fresh, paid lookup is
# allowed. Lower this and the Apollo bill rises proportionally.
CONTACT_REUSE_DAYS=90

# Apollo is ALSO off per organisation until somebody switches it on. Migration
# 041 gives every agency a disabled organization_providers row with a 500-credit
# monthly ceiling; the key above does nothing until that row is enabled. Both
# switches have to be on before a single credit can be spent.

# Phone numbers come from Apollo when it has them. A dedicated phone provider
# (Lusha, SignalHire) would be named here — see services/phoneProvider.js.
# Unset means the null implementation: contacts carry whatever phone Apollo
# returned, and nothing else is looked up or billed.
PHONE_PROVIDER=
