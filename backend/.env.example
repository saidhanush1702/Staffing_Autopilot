# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# ── Database (PostgreSQL) ─────────────────────────────────
# app_role: runtime connection. CRUD only, no DDL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=staffing_autopilot
DB_USER=app_role
DB_PASS=app_dev_pw

# migrator_role: used by migrate.js only. Owns the schema.
DB_MIGRATION_USER=migrator_role
DB_MIGRATION_PASS=migrator_dev_pw

# ── Database: managed provider (Neon / Supabase / Render) ──
# Set DATABASE_URL and every DB_* var above is ignored — managed providers
# issue one connection string and usually one role, so there is no
# migrator/app split to make. Migration 005 already guards its GRANT behind a
# pg_roles check, so it skips cleanly when app_role does not exist.
# DATABASE_URL=postgresql://user:password@host/dbname
#
# Only if your provider lets you create a second, more privileged role:
# MIGRATION_DATABASE_URL=

# Managed Postgres requires TLS; a local install does not. Must be "true" for
# Neon, Supabase and Render, or the connection is refused outright.
DB_SSL=false

# ── Auth ──────────────────────────────────────────────────
# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# AES-256-GCM key for reversible password storage.
# MUST be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: passwords are recoverable with this key. Anyone holding both a
# database dump and this value can read every user's plaintext password.
# Keep it out of version control and off the database host in production.
PASSWORD_ENC_KEY=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowlist. Credentials are sent, so '*' is not permitted.
#
# Still required when the frontend host proxies /api to this server. A browser
# attaches Origin to every non-GET/HEAD request — including a SAME-ORIGIN POST
# — and the proxy forwards it. Omitting the deployed origin therefore lets
# GET /api/health pass while every login POST is rejected, which reads like a
# broken login rather than a CORS allowlist miss.
CLIENT_ORIGIN=http://localhost:5173

# ── Split-domain hosting ──────────────────────────────────
# Only when the SPA is served from a DIFFERENT domain than this API and no
# proxy sits in front. A SameSite=Lax cookie is not attached to a cross-site
# request, so login appears to succeed and every call after it returns 401.
# Setting this to "true" switches the cookie to SameSite=None + Secure.
#
# Requires HTTPS (Secure cookies are dropped on plain HTTP), and the cookie
# becomes third-party — Safari blocks those by default, which also breaks the
# in-app PDF preview. Prefer the proxy.
CROSS_SITE_COOKIE=false

# ── SMTP (unused in Phase 1, reserved) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# ── Seed defaults (Phase 1 bootstrap) ─────────────────────
SEED_SUPER_ADMIN_EMAIL=superadmin@staffing.local
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_SUPER_ADMIN_NAME=Platform Owner

# ── Job discovery (Phase 5) ───────────────────────────────
# The automatic cycle is OFF unless this is exactly "true", so a fresh checkout
# never starts reaching out on its own.
DISCOVERY_ENABLED=false

# How often the cycle runs. Must divide 24 evenly: 1, 2, 3, 4, 6, 8, 12 or 24.
# Anything else falls back to 12.
#
# THIS IS THE BIGGEST LEVER ON THE BILL. At 6 search terms x 2 pages:
#   every  4h  =  6 runs/day  = ~2,160 credits/month
#   every 12h  =  2 runs/day  =   ~720 credits/month   <- default
#   every 24h  =  1 run/day   =   ~360 credits/month
#
# 12 is the default because the provider's finest recency filter is a DAY.
# Running more often than that mostly re-asks the same question and throws the
# duplicate answers away.
DISCOVERY_CYCLE_HOURS=12

# ── Search provider — Google Jobs via SerpApi ─────────────
# Postings come from Google's index of the job boards, not from crawling them.
# Leave SERPAPI_KEY empty and discovery still runs: it fetches nothing, says so
# in the run notes, and matches whatever is already in the posting pool.
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_TIMEOUT_MS=20000

# Country and language for the search.
DISCOVERY_GL=us
DISCOVERY_HL=en

# How recently a job must have been posted to be worth asking for.
# Allowed: today | 3days | week | month   (empty = no filter)
#
# These are Google's own windows and there is nothing shorter — no "last 4
# hours" exists at any price. 3days is the default rather than today because
# Google's index lags the boards by hours; the overlap costs nothing, since
# anything already seen is de-duplicated on arrival.
DISCOVERY_DATE_POSTED=3days

# ── Cost control. EVERY RESULT PAGE IS ONE API CREDIT. ────
#   credits per run = DISCOVERY_MAX_QUERIES x DISCOVERY_MAX_PAGES
# At the defaults below that is 12 per run; on the 4-hour cycle, ~72/day.
# Check these against your plan's monthly quota before switching the cycle on.
DISCOVERY_MAX_QUERIES=6
DISCOVERY_MAX_PAGES=2

# A hard ceiling for one run, whatever the two settings above work out to.
# Stops a misconfiguration from spending a month's quota in a single cycle.
DISCOVERY_MAX_CALLS_PER_RUN=20
