flowchart TD
    %% Styling
    classDef onboarding fill:#1e293b,stroke:#3b82f6,color:#f8fafc,stroke-width:2px;
    classDef gate fill:#78350f,stroke:#f59e0b,color:#fde68a,stroke-width:2px,rx:8,ry:8;
    classDef discovery fill:#1e1b4b,stroke:#818cf8,color:#e0e7ff,stroke-width:2px;
    classDef preparation fill:#4c1d95,stroke:#c084fc,color:#f3e8ff,stroke-width:2px;
    classDef botlane fill:#451a03,stroke:#fbbf24,color:#fef3c7,stroke-width:2px;
    classDef humanlane fill:#064e3b,stroke:#34d399,color:#d1fae5,stroke-width:2px;
    classDef record fill:#020617,stroke:#94a3b8,color:#f8fafc,stroke-width:2px;
    classDef parked fill:#7f1d1d,stroke:#ef4444,color:#fee2e2,stroke-width:2px;

    subgraph PHASE1 ["1. Consultant Setup & Onboarding"]
        direction TB
        ADD["<b>Consultant Added</b><br/>Account & empty profile created"]:::onboarding
        FILL_PROF["Consultant fills profile details"]:::onboarding
        REV_PROF{"GATE 1:<br/>Profile Review"}:::gate
        PROF_LIVE["Profile goes <b>LIVE</b>"]:::onboarding
        
        SET_CRIT["Recruiter sets search criteria<br/>(Titles, keywords, locations)"]:::onboarding
        ACTIVATE{"GATE 2:<br/>Criteria Activation"}:::gate
        
        ANSWERS["Consultant answers standard Q's"]:::onboarding
        REV_ANS{"GATE 3:<br/>Answer Review"}:::gate
        ANS_BANK["Answers enter the Approved Bank"]:::onboarding

        ADD --> FILL_PROF --> REV_PROF
        REV_PROF -->|Rejected| FILL_PROF
        REV_PROF -->|Approved| PROF_LIVE
        
        PROF_LIVE --> SET_CRIT --> ACTIVATE
        PROF_LIVE --> ANSWERS --> REV_ANS
        REV_ANS -->|Rejected| ANSWERS
        REV_ANS -->|Approved| ANS_BANK
    end

    subgraph PHASE2 ["2. Job Discovery (Every 4 Hours)"]
        direction TB
        FIND["<b>Discovery Cycle</b><br/>Finds jobs across the market"]:::discovery
        SCORE_JOB["Scores jobs per consultant"]:::discovery
        QUEUE["Job enters Queue<br/>(Status: Not Yet Ready)"]:::discovery
        
        ACTIVATE -->|Approved| FIND
        FIND --> SCORE_JOB --> QUEUE
    end

    subgraph PHASE3 ["3. AI Preparation"]
        direction TB
        TAILOR["<b>AI Worker</b><br/>Tailors resume & scores fit"]:::preparation
        MARK_READY["Item marked <b>READY</b>"]:::preparation

        QUEUE --> TAILOR
        ANS_BANK -.->|Feeds approved answers| TAILOR
        TAILOR --> MARK_READY
    end

    subgraph PHASE4 ["4. The Application Lanes"]
        direction TB
        LANE{"Which Application System?"}:::gate
        
        subgraph BOT ["Bot Lane (Desktop App)"]
            direction TB
            APP_FILL["<b>Desktop App</b> fills the form<br/>using consultant's browser"]:::botlane
            UNKNOWN{"Unknown<br/>Question?"}:::gate
            PARK["<b>PARKED</b><br/>Wait for answer approval"]:::parked
            REV_BOT{"GATE 4:<br/>Consultant Reviews"}:::gate
            SUB_BOT["Consultant Clicks <b>SUBMIT</b>"]:::botlane
            
            APP_FILL --> UNKNOWN
            UNKNOWN -->|Yes| PARK
            PARK -.->|Requires new answer in| ANSWERS
            UNKNOWN -->|No| REV_BOT -->|Approves| SUB_BOT
        end
        
        subgraph HUMAN ["Human Lane (Web Portal)"]
            direction TB
            SHOW["<b>Portal</b> shows the job<br/>& tailored resume"]:::humanlane
            APP_DIR["Consultant applies directly<br/>in their browser"]:::humanlane
            SUB_HUM["Consultant Marks as Applied"]:::humanlane
            
            SHOW --> APP_DIR --> SUB_HUM
        end
        
        MARK_READY --> LANE
        LANE -->|LinkedIn, Built In, etc| APP_FILL
        LANE -->|Greenhouse, Workday, etc| SHOW
    end

    subgraph PHASE5 ["5. Post-Submission Record"]
        direction TB
        PERM["<b>Permanent Record Store</b><br/>Every exact question, exact answer,<br/>and exact resume kept forever"]:::record
        
        SUB_BOT --> PERM
        SUB_HUM --> PERM
    end
